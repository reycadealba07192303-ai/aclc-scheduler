# Safe template only. Actual credentials live in gitignored src/backend/.env.
# Local MongoDB. For Atlas use: mongodb+srv://<user>:<password>@<cluster>/aclc_scheduler
MONGODB_URI=mongodb://127.0.0.1:27017/aclc_scheduler
AUTH_SECRET=generate-a-random-32-byte-base64url-secret
AUTH_BOOTSTRAP_KEY=generate-a-different-random-one-time-admin-setup-key

# Optional SMTP settings for teacher email verification and password setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
