# Safe template only — never put real values in this file (the repository is public).
# Local development: copy to src/backend/.env and fill in.
# Production (Vercel): set the same names under Project → Settings → Environment Variables.

# MongoDB connection, including the database name.
# Local:  mongodb://127.0.0.1:27017/aclc_scheduler
# Atlas:  mongodb+srv://<app-user>:<password>@<cluster-host>/aclc_scheduler?appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/aclc_scheduler

# Signs sign-in sessions and attendance QR codes. 32+ random bytes, base64url.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value in production than in development.
AUTH_SECRET=generate-a-random-32-byte-base64url-secret

# One-time key for creating the first administrator at /setup-admin.
AUTH_BOOTSTRAP_KEY=generate-a-different-long-random-value-for-setup-only

# Email for account-setup and password-reset codes (for example Gmail with an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: where the landing page's "Download for Android" button points.
# Production: the latest GitHub Release file, e.g.
#   https://github.com/<owner>/<repo>/releases/latest/download/aclc-scheduler-teacher.apk
# Leave empty locally to use public/downloads/aclc-scheduler-teacher.apk if present.
TEACHER_APP_URL=
TEACHER_APP_VERSION=
TEACHER_APP_SIZE=
