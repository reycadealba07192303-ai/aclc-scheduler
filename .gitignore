# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files may contain credentials; only the safe template is versioned.
.env
.env.*
!.env.example
/src/backend/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Teacher app downloads are build output (the debug APK is over GitHub's 100 MB limit); host releases separately.
/public/downloads/*.apk

# Kept local only; the repository is public.
/systemsecured.md
/WORKLOG.md
/BSIS-1.pdf
/BSIS-2.pdf
